# 공공데이터포털 일반 인증키 — 「Decoding」 키를 넣는다(코드가 URL 인코딩한다).
# 로컬은 .env.local 에, 배포는 Vercel 프로젝트 Settings → Environment Variables 에 넣는다.
DATA_GO_KR_SERVICE_KEY=

# 카카오맵 JavaScript 키 — 브라우저에 공개되는 키다. 카카오 콘솔에서 사이트 도메인 제한을 꼭 건다.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# (선택) 카카오 REST API 키 — 맛집을 카카오 로컬에서 찾는다. 서버에서만 쓴다(NEXT_PUBLIC_ 붙이지 않는다).
# 없으면 관광공사 음식점으로 찾는다.
KAKAO_REST_API_KEY=
