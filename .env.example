# 공공데이터포털 일반 인증키 — 「Decoding」 키를 넣는다(코드가 URL 인코딩한다).
# 로컬은 .env.local 에, 배포는 Vercel 프로젝트 Settings → Environment Variables 에 넣는다.
DATA_GO_KR_SERVICE_KEY=

# 카카오맵 JavaScript 키 — 브라우저에 공개되는 키다. 카카오 콘솔에서 사이트 도메인 제한을 꼭 건다.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# (선택) 카카오 REST API 키 — 맛집을 카카오 로컬에서 찾는다. 서버에서만 쓴다(NEXT_PUBLIC_ 붙이지 않는다).
# 없으면 관광공사 음식점으로 찾는다.
KAKAO_REST_API_KEY=
# 같은 키로 카카오모빌리티 길찾기(차 이동 시간)도 쓴다. 없으면 직선 거리만 보여 준다.

# (선택) OpenAI API 키 — 일정 하루 소개 글(AI). 서버에서만 쓴다. 없으면 소개 글 없이 일정만 보여 준다.
# OpenAI 대시보드(Limits)에서 월 사용 한도를 걸어 둘 것.
OPENAI_API_KEY=

# DB(Postgres) — 로컬은 docker, 운영은 Vercel Storage 의 Neon 이 자동으로 넣어 준다.
# docker run -d --name holiday-trip-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=holiday_trip -p 54329:5432 postgres:17-alpine
DATABASE_URL=postgres://postgres:postgres@localhost:54329/holiday_trip

# 카카오 로그인 — 카카오 콘솔 「보안 → Client Secret」. 회원 번호와 닉네임(필수 동의)만 받는다.
# Redirect URI 는 <사이트 주소>/api/auth/kakao/callback (로컬·운영 둘 다 등록)
KAKAO_CLIENT_SECRET=
# 로그인 세션 쿠키 서명 키 — 32자 이상 무작위. openssl rand -base64 32
AUTH_SECRET=

# (로컬 전용) 날씨 화면 미리보기 — rain(내내 비) 또는 mixed(맑음·소나기·비). 기상청을 부르지 않고 연휴 모든 날에 가짜 날씨를 채운다.
# Vercel 에서는 값이 있어도 무시한다.
# WEATHER_PREVIEW=mixed
