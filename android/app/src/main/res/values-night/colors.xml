<!--
  다크 모드 폰의 스플래시 바탕 — 밤바다(웹의 다크 화면 바탕과 같다).
  밝은 화면 값은 build.gradle 의 backgroundColor(resValue)가 만든다. Bubblewrap 은 색을 하나만 받아서 이 파일로 다크만 덮어쓴다.
  bubblewrap update 로 프로젝트를 다시 만들면 지워질 수 있으니 그 뒤에 남아 있는지 확인한다.
-->
<resources>
    <color name="backgroundColor">#1F3340</color>
</resources>
